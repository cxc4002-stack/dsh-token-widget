{
  "name": "dsh-token-widget",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web UI floating widget: total token usage and per-session status.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxc4002-stack/dsh-token-widget.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/verify.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token",
    "usage",
    "widget"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
